rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function hasValidProfileFields(data) {
      return (!("username" in data) || (
          data.username is string &&
          data.username.size() <= 64
        )) &&
        (!("displayName" in data) || (
          data.displayName is string &&
          data.displayName.size() <= 128
        )) &&
        (!("pfpUrl" in data) || (
          data.pfpUrl is string &&
          data.pfpUrl.size() <= 512
        ));
    }

    function isValidPost(data) {
      return data.keys().hasOnly([
        "title",
        "body",
        "fid",
        "username",
        "displayName",
        "pfpUrl",
        "createdAt",
        "approvePower",
        "denyPower",
        "threadCount",
        "uid"
      ]) &&
      data.title is string &&
      data.title.size() > 0 &&
      data.title.size() <= 120 &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 1200 &&
      data.fid is int &&
      isNumber(data.approvePower) &&
      data.approvePower >= 0 &&
      isNumber(data.denyPower) &&
      data.denyPower >= 0 &&
      isNumber(data.threadCount) &&
      data.threadCount >= 0 &&
      data.uid == request.auth.uid &&
      data.createdAt == request.time &&
      hasValidProfileFields(data);
    }

    function baseApprovePower() {
      return isNumber(resource.data.approvePower) ? resource.data.approvePower : 0;
    }

    function baseDenyPower() {
      return isNumber(resource.data.denyPower) ? resource.data.denyPower : 0;
    }

    function baseThreadCount() {
      return isNumber(resource.data.threadCount) ? resource.data.threadCount : 0;
    }

    function userVotePath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid);
    }

    function hasFreshUserVote(postId, direction, power) {
      return existsAfter(userVotePath(postId)) &&
        getAfter(userVotePath(postId)).data.keys().hasOnly([
          "fid",
          "uid",
          "direction",
          "power",
          "createdAt"
        ]) &&
        getAfter(userVotePath(postId)).data.uid == request.auth.uid &&
        getAfter(userVotePath(postId)).data.fid is int &&
        getAfter(userVotePath(postId)).data.direction == direction &&
        getAfter(userVotePath(postId)).data.power == power &&
        getAfter(userVotePath(postId)).data.createdAt == request.time;
    }

    function isApproveIncrement(postId) {
      return request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["approvePower"]) &&
        isNumber(request.resource.data.approvePower) &&
        request.resource.data.approvePower > baseApprovePower() &&
        hasFreshUserVote(
          postId,
          "approve",
          request.resource.data.approvePower - baseApprovePower()
        );
    }

    function isDenyIncrement(postId) {
      return request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["denyPower"]) &&
        isNumber(request.resource.data.denyPower) &&
        request.resource.data.denyPower > baseDenyPower() &&
        hasFreshUserVote(
          postId,
          "deny",
          request.resource.data.denyPower - baseDenyPower()
        );
    }

    function isThreadIncrement() {
      return request.resource.data.diff(resource.data).changedKeys()
          .hasOnly(["threadCount"]) &&
        isNumber(request.resource.data.threadCount) &&
        request.resource.data.threadCount == baseThreadCount() + 1;
    }

    function isValidThread(data) {
      return data.keys().hasOnly([
        "body",
        "fid",
        "uid",
        "username",
        "displayName",
        "pfpUrl",
        "createdAt"
      ]) &&
      data.body is string &&
      data.body.size() > 0 &&
      data.body.size() <= 800 &&
      data.fid is int &&
      data.uid == request.auth.uid &&
      data.createdAt == request.time &&
      hasValidProfileFields(data);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPost(request.resource.data);
      allow update: if isSignedIn() && (
        isApproveIncrement(postId) ||
        isDenyIncrement(postId) ||
        isThreadIncrement()
      );
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly([
            "fid",
            "uid",
            "direction",
            "power",
            "createdAt"
          ]) &&
          voteId == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.fid is int &&
          request.resource.data.direction in ["approve", "deny"] &&
          isNumber(request.resource.data.power) &&
          request.resource.data.power > 0 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /threads/{threadId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidThread(request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
